{
  "name": "Mortgage Client Platform",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/mortgage-client-platform",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Mortgage Client Platform",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"],
      "settings": {
        "files.exclude": { "data": true }
      }
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
